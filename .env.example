# Единственный файл окружения проекта. Скопируйте в .env рядом (в корне репозитория) и заполните.
# Его читают все способы запуска: docker compose, npm-скрипты api и web. Файл .env в git не попадает (D-4, C4).
# Валидация: apps/api/src/config.ts и apps/web/src/server/config.ts — при ошибке сервис не стартует и называет переменную.

# ─── CoinMarketCap (D-4): ключ только через env, в логах и ответах API его нет ───
# Ключ: https://coinmarketcap.com/api/ (план Basic). Для стаба подойдёт любое значение
CMC_API_KEY=
# Куда ходит api:
#   локальный запуск (npm) — по умолчанию настоящий CoinMarketCap; для локального стаба: http://localhost:4010
#   docker compose         — по умолчанию стаб из того же compose; для настоящего: https://pro-api.coinmarketcap.com
# Значение http://localhost:4010 годится только для локального запуска: перед docker compose строку закомментировать
# CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_MS=10000

# ─── api ───
# Порт api: локально — порт процесса, в docker compose — порт на хосте
PORT=3000
LOG_LEVEL=info
# SQLite (C2, C3). Путь относительно каталога apps/api; в Docker не используется — там том /data
DATABASE_PATH=./data/cpt.db
# Синхронизация (F6): не меньше 180000 — иначе не хватит квоты CMC Basic (ADR 0007)
SYNC_INTERVAL_MS=300000

# ─── Ключи api (ADR 0002) ───
# Два разных ключа вида cpt_ + 43 символа. api принимает их при старте (в БД — только SHA-256),
# web ходит с ними в api: viewer — чтение цен, operator — запись. Сгенерировать (выполнить дважды):
#   node -e "console.log('cpt_' + require('node:crypto').randomBytes(32).toString('base64url'))"
BOOTSTRAP_VIEWER_KEY=
BOOTSTRAP_OPERATOR_KEY=

# ─── web (сверх ТЗ; для запуска одного api не нужен) ───
# Первый оператор. Хэш, а не пароль: npm run hash-password -w @cpt/web
# Хэш — в одинарных кавычках, знаки $ не экранируются: 'scrypt$17$8$1$…'
WEB_BOOTSTRAP_LOGIN=
WEB_BOOTSTRAP_PASSWORD_HASH=
# Адрес api для локального web — только origin, без пути. В Docker задаётся самим compose
API_BASE_URL=http://localhost:3000
# Сколько ждать ответа api, мс (100–120000)
API_TIMEOUT_MS=10000
# SQLite web (пользователи и сессии, ADR 0016). Путь относительно каталога apps/web; в Docker — том /data
WEB_DATABASE_PATH=./data/web.db
# true — только если перед web стоит свой обратный прокси, который задаёт X-Forwarded-For и X-Forwarded-Proto
WEB_TRUST_PROXY=false
# Порт web на хосте в docker compose (локально web слушает 3001: npm run dev -w @cpt/web)
WEB_PORT=3001

# Отдельные ключи api для web (необязательно): по умолчанию web берёт BOOTSTRAP_VIEWER_KEY и BOOTSTRAP_OPERATOR_KEY
# API_VIEWER_KEY=
# API_OPERATOR_KEY=
