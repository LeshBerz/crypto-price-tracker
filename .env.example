# Скопируйте в apps/api/.env и заполните. Файл .env в git не попадает (D-4, C4).
# Полный список и валидация — apps/api/src/config.ts

# HTTP
PORT=3000
LOG_LEVEL=info

# SQLite (C2, C3): файл БД — вне репозитория
DATABASE_PATH=./data/cpt.db

# CoinMarketCap (D-4): ключ только через env, в логах и ответах API его нет
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_MS=10000

# Синхронизация (F6): не меньше 180000 — иначе не хватит квоты CMC Basic (ADR 0007)
SYNC_INTERVAL_MS=300000

# Bootstrap API-ключей (ADR 0002): ключ вида cpt_…, при старте записывается его SHA-256
BOOTSTRAP_VIEWER_KEY=
BOOTSTRAP_OPERATOR_KEY=
