# Скопируйте в apps/web/.env.local и заполните. Файлы .env* в git не попадают.
# Полный список и валидация — apps/web/src/server/config.ts

# Доступ к apps/api (BFF, ADR 0016). Ключи остаются на сервере Next: в браузер, ответы и логи не попадают.
# Адрес api — только origin, без пути
API_BASE_URL=http://localhost:3000
# Два разных ключа api: роль viewer (только чтение цен) и роль operator. Выпуск — из каталога репозитория:
#   npm run keys:create -w @cpt/api -- --name web-viewer --role viewer
#   npm run keys:create -w @cpt/api -- --name web-operator --role operator
API_VIEWER_KEY=
API_OPERATOR_KEY=
# Сколько ждать ответа api, мс (100–120000)
API_TIMEOUT_MS=10000

# SQLite web (пользователи и сессии, ADR 0016): отдельный файл, не БД api
WEB_DATABASE_PATH=./data/web.db

# Первый оператор. Хэш, а не пароль: npm run hash-password -w @cpt/web
# В файле .env.local знак $ в хэше экранируется обратной косой чертой: scrypt\$17\$8\$1\$...
WEB_BOOTSTRAP_LOGIN=
WEB_BOOTSTRAP_PASSWORD_HASH=

# true — только если перед web стоит свой обратный прокси, который задаёт X-Forwarded-For и X-Forwarded-Proto
WEB_TRUST_PROXY=false
