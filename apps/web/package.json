{
  "name": "@cpt/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Дашборд и панель оператора: Next.js (BFF + UI). Бонус к базовой версии, ограничения ТЗ на него не действуют",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "codegen": "openapi-typescript ../api/openapi/openapi.yaml -o src/generated/api-types.ts",
    "codegen:check": "npm run codegen && node ../api/scripts/assert-clean.ts src/generated",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  }
}
